views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "_articles"
    order:
      - title
      - file.name
      - published
      - file.ctime
      - image
      - flickr_album
    sort:
      - property: title
        direction: ASC
      - property: file.ctime
        direction: DESC
    columnSize:
      note.title: 272
      file.name: 319
      note.published: 150
      file.ctime: 210
      note.image: 488
