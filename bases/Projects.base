properties:
  file.name:
    displayName: Title
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("_projects")
    order:
      - title
      - file.basename
      - file.ctime
      - flickr_album
      - image
      - tags
      - published
    sort:
      - property: file.name
        direction: DESC
